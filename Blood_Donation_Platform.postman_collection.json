						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/users/donors?bloodGroup=O_POSITIVE&city=Dhaka&page=1&limit=10",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "users", "donors"],
							"query": [
								{ "key": "bloodGroup", "value": "O_POSITIVE" },
								{ "key": "city", "value": "Dhaka" },
								{ "key": "page", "value": "1" },
								{ "key": "limit", "value": "10" }
