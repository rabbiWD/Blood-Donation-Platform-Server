	"item": [
		{
			"name": "1. Authentication & Email Verification",
			"item": [
				{
					"name": "Register Donor",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"John Donor\",\n  \"email\": \"john.donor@example.com\",\n  \"password\": \"Donor@123456\",\n  \"role\": \"DONOR\",\n  \"donor\": {\n    \"bloodGroup\": \"O_POSITIVE\",\n    \"contactNumber\": \"+8801711111111\",\n    \"address\": \"Road 11, Banani\",\n    \"city\": \"Dhaka\",\n    \"district\": \"Dhaka\",\n    \"isAvailable\": true\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "register"]
						}
					}
				},
				{
					"name": "Register Patient",
