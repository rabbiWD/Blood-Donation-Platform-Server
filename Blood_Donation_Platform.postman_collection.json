							"raw": "{\n  \"name\": \"Jane Patient\",\n  \"email\": \"jane.patient@example.com\",\n  \"password\": \"Patient@123456\",\n  \"role\": \"PATIENT\",\n  \"patient\": {\n    \"contactNumber\": \"+8801822222222\",\n    \"address\": \"Gulshan 1\",\n    \"hospitalName\": \"Square Hospital\"\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "register"]
						}
					}
				},
