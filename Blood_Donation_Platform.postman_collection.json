		{
			"name": "2. User & Donor Profiles",
			"item": [
				{
					"name": "Update User Profile",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{accessToken}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Jane Updated Patient\",\n  \"contactNumber\": \"+8801899999999\",\n  \"address\": \"Dhanmondi, Dhaka\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/users/me",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "users", "me"]
						}
