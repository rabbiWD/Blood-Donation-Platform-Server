		{
			"name": "4. Blood Requests & Matching",
			"item": [
				{
					"name": "Create Emergency Blood Request",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{accessToken}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"patientName\": \"Alice Smith\",\n  \"bloodGroup\": \"O_POSITIVE\",\n  \"unitsNeeded\": 2,\n  \"hospitalName\": \"Apollo Hospital\",\n  \"hospitalAddress\": \"Plot 81, Block E, Bashundhara R/A\",\n  \"city\": \"Dhaka\",\n  \"district\": \"Dhaka\",\n  \"urgency\": \"CRITICAL\",\n  \"neededBy\": \"2026-09-10T12:00:00.000Z\",\n  \"additionalNotes\": \"Urgent blood required for emergency surgery.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/blood-requests",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "blood-requests"]
						}
					}
				},
				{
					"name": "List All Active Blood Requests (Paginated & Filtered)",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/v1/blood-requests?status=PENDING&urgency=CRITICAL&page=1&limit=10",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "blood-requests"],
							"query": [
								{ "key": "status", "value": "PENDING" },
								{ "key": "urgency", "value": "CRITICAL" },
								{ "key": "page", "value": "1" },
								{ "key": "limit", "value": "10" }
							]
						}
					}
				},
				{
					"name": "Get Compatible Requests for Donor",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{accessToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/blood-requests/compatible-requests",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "blood-requests", "compatible-requests"]
						}
					}
				},
				{
					"name": "Get Blood Request Details",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/v1/blood-requests/{{requestId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "blood-requests", "{{requestId}}"]
						}
					}
				},
				{
					"name": "Donor Accept Blood Request",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{accessToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/blood-requests/{{requestId}}/accept",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "blood-requests", "{{requestId}}", "accept"]
						}
					}
				},
				{
					"name": "Complete Blood Donation",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{accessToken}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"donorUserId\": \"{{donorUserId}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/blood-requests/{{requestId}}/complete",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "blood-requests", "{{requestId}}", "complete"]
						}
					}
				},
				{
					"name": "Soft Delete Blood Request",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{accessToken}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/blood-requests/{{requestId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "blood-requests", "{{requestId}}"]
						}
					}
				}
			]
		},
